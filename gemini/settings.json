{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://localhost:54321/mcp?read_only=true"
      ]
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Ayu",
    "hideBanner": true,
    "hideTips": true,
    "footer": {
      "hideSandboxStatus": true
    },
    "accessibility": {
      "disableLoadingPhrases": true
    }
  },
  "output": {
    "format": "text"
  }
}
# Copy to /etc/ausschreibung-monitor.env, edit it, and keep mode 0600.
# Separate multiple values with semicolons so phrases may contain spaces.

# Secret generated by a Slack app with Incoming Webhooks enabled.
AUSSCHREIBUNG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# Non-secret matching rules live declaratively in ausschreibung-monitor.json.

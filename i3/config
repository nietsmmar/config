# i3 config file (v4)
#
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

set $super Mod4
set $alt Mod1

set $laptop   eDP-1
set $monitor1 DP-2-8
set $monitor2 DP-2-1-1

workspace "1:main"     output $monitor1                                                                                                                                                      
workspace "2:telegram" output $monitor2
workspace "3:browsing" output $monitor1                                                                                                                                                      
workspace "4:mail"     output $monitor2
workspace "5:music"    output $monitor2                                                                                                                                                      
workspace "6:backend"  output $laptop
workspace "7:scripts"  output $monitor1                                                                                                                                                      
workspace "8:keepass"  output $monitor2

# setting Apps floating
#for_window [class="Skype" instance="skype"] floating enable
for_window [class="python" instance="pygame"] floating enable
for_window [class="Nautilus" instance="file_progress"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [class="Xfce4-notifyd"] floating enable; border none
for_window [title="Android Emulator$"] floating enable; border none

# start Apps on specific Workspace
assign [class="Spotify"] → 5:music
assign [class="TelegramDesktop" instance="Telegram"] → 2:telegram
assign [class="Slack" instance="slack"] → 2:telegram

assign [class="Lxappearance" instance="lxappearance"] ~
assign [class="Betterbird" instance="Mail"] → 4:mail
assign [class="Betterbird" instance="Dialog"] → 4:mail

# disable titlebar
default_border pixel 1
for_window [class="^.*"] border pixel 1

# browse through workspaces
bindsym $alt+Shift+a workspace prev
bindsym $alt+Shift+s workspace next

# move to workspace
bindsym $alt+$super+Shift+a move workspace prev
bindsym $alt+$super+Shift+s move workspace next

# font for window titles. ISO 10646 = Unicode
font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
#font pango: Dejavu Sans Mono 10

# Use Mouse+$super to drag floating windows to their wanted position
floating_modifier $alt

# start a terminal
bindsym $super+space exec kitty

# kill focused window
bindsym $alt+Shift+Q kill

# start dmenu (a program launcher)
bindsym $super+d exec dmenu_run

# start NetworkManager
exec --no-startup-id nm-applet

# start .Xmodmap
exec --no-startup-id xmodmap ~/dev/config/xmodmap

# start xrandr screen config
exec --no-startup-id ~/dev/config/screenlayout/daisy.sh

# start picom for laptop
exec --no-startup-id picom --config ~/.i3/picom_config

# start flux
exec redshift -l 49.0047222:8.3858333

# lock Screen after 15 minutes inactivity
exec xautolock -time 15 -locker lockScreen &
exec --no-startup-id $HOME/dev/config/scripts/prevent_display_sleep_on_audio.sh &

# fix mouse sensitivity
exec xinput --set-prop 15 329 -0.3

# toggle touchpad
bindsym $super+t exec ~/dev/config/scripts/toggle-touchpad

# change focus
bindsym $super+j focus left
bindsym $super+k focus down
bindsym $super+l focus up
bindsym $super+odiaeresis focus right

# alternatively, you can use the cursor keys:
bindsym $super+Left focus left
bindsym $super+Down focus down
bindsym $super+Up focus up
bindsym $super+Right focus right

# move focused window
bindsym $super+Shift+J move left
bindsym $super+Shift+K move down
bindsym $super+Shift+L move up
bindsym $super+Shift+Odiaeresis move right

# alternatively, you can use the cursor keys:
bindsym $super+Shift+Left move left
bindsym $super+Shift+Down move down
bindsym $super+Shift+Up move up
bindsym $super+Shift+Right move right

# split in horizontal orientation
bindsym $alt+h split h

# split in vertical orientation
bindsym $alt+v split v

# enter fullscreen mode for the focused container
bindsym $alt+f fullscreen

# change container layout (stacked, tabbed, default)
#bindsym $alt+s layout stacking
bindsym $super+w layout tabbed
bindsym $super+e layout default

# toggle tiling / floating
bindsym $super+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $alt+x focus mode_toggle

# focus the parent container
bindsym $alt+a focus parent

# focus the child container
bindsym $super+$alt+a focus child

# switch to workspace
bindsym $super+1 workspace 1:main
bindsym $super+2 workspace 2:telegram
bindsym $super+3 workspace 3:browsing
bindsym $super+4 workspace 4:mail
bindsym $super+5 workspace 5:music
bindsym $super+6 workspace 6:backend
bindsym $super+7 workspace 7:scripts
bindsym $super+8 workspace 8:keepass
bindsym $super+9 workspace 9
bindsym $super+0 workspace 10

# move focused container to workspace
bindsym $super+Shift+exclam move workspace 1:main; workspace 1:main
bindsym $super+Shift+quotedbl move workspace 2:telegram; workspace 2:telegram
bindsym $super+Shift+section move workspace 3:browsing; workspace 3:browsing
bindsym $super+Shift+dollar move workspace 4:mail; workspace 4:mail
bindsym $super+Shift+percent move workspace 5:music; workspace 5:music
bindsym $super+Shift+ampersand move workspace 6:backend; workspace 6:backend
bindsym $super+Shift+slash move workspace 7:scripts; workspace 7:scripts
bindsym $super+Shift+parenleft move workspace 8:keepass; workspace 8:keepass
bindsym $super+Shift+parenright move workspace 9; workspace 9
bindsym $super+Shift+equal move workspace 10; workspace 10

# Multimedia Keys
# increase volume
bindsym XF86AudioRaiseVolume exec amixer -q set Master 5%+ unmute
# decrease volume
bindsym XF86AudioLowerVolume exec amixer -q set Master 5%- unmute
# mute volume
bindsym XF86AudioMute exec amixer -q set Master toggle
# brightness
bindsym XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
# pause / play
#bindsym XF86AudioPlay exec playerctl play-pause
bindcode 127 exec playerctl play-pause


# reload the configuration file
bindsym $alt+Shift+C reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $super+Shift+R restart
# exit i3 (logs you out of your X session)
bindsym $super+Shift+E exit

# lockscreen
bindsym $alt+Shift+L exec lockScreen

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # They resize the border in the direction you pressed, e.g.
        # when pressing left, the window is resized so that it has
        # more space on its left

		bindsym j resize shrink left 10 px or 10 ppt
		bindsym Shift+J resize grow   left 10 px or 10 ppt

		bindsym k resize shrink down 10 px or 10 ppt
		bindsym Shift+K resize grow   down 10 px or 10 ppt

		bindsym l resize shrink up 10 px or 10 ppt
		bindsym Shift+L resize grow   up 10 px or 10 ppt

		bindsym odiaeresis resize shrink right 10 px or 10 ppt
		bindsym Shift+Odiaeresis resize grow   right 10 px or 10 ppt

		# same bindings, but for the arrow keys
		bindsym Left resize shrink left 10 px or 10 ppt
		bindsym Shift+Left resize grow   left 10 px or 10 ppt

		bindsym Down resize shrink down 10 px or 10 ppt
		bindsym Shift+Down resize grow   down 10 px or 10 ppt

		bindsym Up resize shrink up 10 px or 10 ppt
		bindsym Shift+Up resize grow   up 10 px or 10 ppt

		bindsym Right resize shrink right 10 px or 10 ppt		bindsym Shift+Right resize grow   right 10 px or 10 ppt

		# back to normal: Enter or Escape
		bindsym Return mode "default"
		bindsym Escape mode "default"
}

bindsym $super+$alt+r mode "resize"

mode "gameMode" {
    bindsym $super+Escape mode "default", exec xautolock -time 15 -locker lockScreen &
    # Multimedia Keys
    # increase volume
    bindsym XF86AudioRaiseVolume exec amixer -q set Master 5%+ unmute
    # decrease volume
    bindsym XF86AudioLowerVolume exec amixer -q set Master 5%- unmute
    # mute volume
    bindsym XF86AudioMute exec amixer -q set Master toggle
    # pause / play / next / previous
    #bindsym XF86AudioPlay exec playerctl play-pause
    bindcode 127 exec playerctl play-pause
}
bindsym $super+Escape mode "gameMode", exec --no-startup-id killScreenSaver

#background color
exec hsetroot -solid #000000

mode "startPrograms" {
    bindsym t exec Telegram; mode "default"
    bindsym e exec betterbird; mode "default"
    bindsym g exec firefox -private-window; mode "default"
    bindsym y exec spotify; mode "default"
    bindsym h exec startProgram; mode "default"
    bindsym s exec steam; mode "default"
    bindsym k exec kolourpaint; mode "default"
    bindsym l exec libreoffice; mode "default"
    bindsym i exec inkscape; mode "default"
    bindsym n exec nautilus; mode "default"
    bindsym f exec google-chrome-stable --incognito; mode "default"
    bindsym u exec xmodmap ~/dev/config/xmodmap/xmodmap; mode "default"
    bindsym q exec ~/dev/config/screenlayout/daisy.sh; mode "default"
    bindsym a exec ~/dev/config/screenlayout/config.sh; mode "default"
    bindsym x exec slack; mode "default"
    bindsym p exec flameshot gui; mode "default"
    bindsym $super+g mode "default"
}
bindsym $super+g mode "startPrograms" 
#, exec startProgramC

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available
#tray output
bar {
	i3bar_command i3bar
	status_command ~/dev/config/scripts/i3status_timer
	position bottom

## please set your primary output first. Example: 'xrandr --output eDP1 --primary'
	tray_output primary
#	tray_output eDP1

	bindsym button4 nop
	bindsym button5 nop
    font pango:Iosevka 10
	strip_workspace_numbers yes

    colors {
        background #222D31
        statusline #F9FAF9
        separator  #16a085

#                      border  backgr. text
        focused_workspace  #F9FAF9 #16a085 #292F34
        active_workspace   #595B5B #353836 #FDF6E3
        inactive_workspace #595B5B #222D31 #EEE8D5
        binding_mode       #16a085 #2C2C2C #F9FAF9
        urgent_workspace   #16a085 #FDF6E3 #E5201D
    }
}

# hide/unhide i3status bar
bindsym $super+m bar mode toggle


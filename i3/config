set $modeOne Mod4
set $modeTwo Mod1

set $monitor1 DP-2-8
set $monitor2 DP-2-1-1

workspace 1:main output $monitor1
workspace 1 output $monitor1
workspace 2:telegram output $monitor2
workspace 2 output $monitor2
workspace 3:study output $monitor1
workspace 3 output $monitor1
workspace 4:mail output $monitor2
workspace 4 output $monitor2
workspace 5:music output $monitor2
workspace 5 output $monitor2
workspace 7:scripts output $monitor1
workspace 7 output $monitor1
workspace 8 output $monitor2
workspace 9 output $monitor2
workspace 10 output $monitor2

#exec --no-startup-id compton # no tearing windows

# setting Apps floating
#for_window [class="Skype" instance="skype"] floating enable
for_window [class="python" instance="pygame"] floating enable
for_window [class="Nautilus" instance="file_progress"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [class="Xfce4-notifyd"] floating enable; border none
for_window [title="Android Emulator$"] floating enable; border none



# start Apps on specific Workspace
assign [id=25165825] → 5:music
assign [class="TelegramDesktop" instance="Telegram"] → 2:telegram
assign [class="Slack" instance="slack"] → 2:telegram

assign [class="Lxappearance" instance="lxappearance"] ~
assign [class="Thunderbird" instance="Mail"] → 4:mail
assign [class="Thunderbird" instance="Dialog"] → 4:mail

# mutliple monitors
#force_xinerama yes
#exec xrandr --output VGA-1 --auto --left-of DVI-I-1
#exec xrandr --output DFP5 --auto --left-of CRT1

# disable titlebar
new_window 1pixel
for_window [class="^.*"] border pixel 1

# browse through workspaces
bindsym $modeTwo+Shift+a workspace prev
bindsym $modeTwo+Shift+s workspace next

# move to workspace
bindsym $modeTwo+$modeOne+Shift+a move workspace prev
bindsym $modeTwo+$modeOne+Shift+s move workspace next



# font for window titles. ISO 10646 = Unicode
font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
#font pango: Dejavu Sans Mono 10

# Use Mouse+$modeOne to drag floating windows to their wanted position
floating_modifier $modeTwo

# start a terminal
bindsym $modeOne+space exec kitty

# kill focused window
bindsym $modeTwo+Shift+Q kill

# start dmenu (a program launcher)
bindsym $modeOne+d exec dmenu_run

# start NetworkManager
exec --no-startup-id nm-applet

# start .Xmodmap
exec --no-startup-id xmodmap ~/dev/config/xmodmap

# start xrandr screen config
exec --no-startup-id ~/dev/config/screenlayout/daisy.sh

# start picom for laptop
exec --no-startup-id picom --config ~/.i3/picom_config

#exec_always --no-startup-id picom  -b --config ~/.config/picom.conf

# start flux
#exec xflux -l 49.0047222 -g 8.3858333
exec redshift -l 49.0047222:8.3858333

# lock Screen after 15 minutes inactivity
exec xautolock -time 15 -locker lockScreen &
exec --no-startup-id $HOME/dev/config/scripts/prevent_display_sleep_on_audio.sh &

# fix mouse sensitivity
exec xinput --set-prop 15 329 -0.3

# change focus
bindsym $modeOne+j focus left
bindsym $modeOne+k focus down
bindsym $modeOne+l focus up
bindsym $modeOne+odiaeresis focus right

# alternatively, you can use the cursor keys:
bindsym $modeOne+Left focus left
bindsym $modeOne+Down focus down
bindsym $modeOne+Up focus up
bindsym $modeOne+Right focus right

# move focused window
bindsym $modeOne+Shift+J move left
bindsym $modeOne+Shift+K move down
bindsym $modeOne+Shift+L move up
bindsym $modeOne+Shift+Odiaeresis move right

# alternatively, you can use the cursor keys:
bindsym $modeOne+Shift+Left move left
bindsym $modeOne+Shift+Down move down
bindsym $modeOne+Shift+Up move up
bindsym $modeOne+Shift+Right move right

# split in horizontal orientation
bindsym $modeTwo+h split h

# split in vertical orientation
bindsym $modeTwo+v split v

# enter fullscreen mode for the focused container
bindsym $modeTwo+f fullscreen

# change container layout (stacked, tabbed, default)
#bindsym $modeTwo+s layout stacking
bindsym $modeOne+w layout tabbed
bindsym $modeOne+e layout default

# toggle tiling / floating
bindsym $modeOne+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $modeTwo+x focus mode_toggle

# focus the parent container
bindsym $modeTwo+a focus parent

# focus the child container
bindsym $modeOne+$modeTwo+a focus child

# switch to workspace
bindsym $modeOne+1 workspace 1:main
bindsym $modeOne+2 workspace 2:telegram
bindsym $modeOne+3 workspace 3:study
bindsym $modeOne+4 workspace 4:mail
bindsym $modeOne+5 workspace 5:music
bindsym $modeOne+6 workspace 6:trello
bindsym $modeOne+7 workspace 7:scripts
bindsym $modeOne+8 workspace 8
bindsym $modeOne+9 workspace 9
bindsym $modeOne+0 workspace 10

# move focused container to workspace
bindsym $modeOne+Shift+exclam move workspace 1:main; workspace 1:main
bindsym $modeOne+Shift+quotedbl move workspace 2:telegram; workspace 2:telegram
bindsym $modeOne+Shift+section move workspace 3:study; workspace 3:study
bindsym $modeOne+Shift+dollar move workspace 4:mail; workspace 4:mail
bindsym $modeOne+Shift+percent move workspace 5:music; workspace 5:music
bindsym $modeOne+Shift+ampersand move workspace 6:trello; workspace 6:trello
bindsym $modeOne+Shift+slash move workspace 7:scripts; workspace 7:scripts
bindsym $modeOne+Shift+parenleft move workspace 8; workspace 8
bindsym $modeOne+Shift+parenright move workspace 9; workspace 9
bindsym $modeOne+Shift+equal move workspace 10; workspace 10

# Multimedia Keys
# increase volume
bindsym XF86AudioRaiseVolume exec amixer -q set Master 5%+ unmute
# decrease volume
bindsym XF86AudioLowerVolume exec amixer -q set Master 5%- unmute
# mute volume
bindsym XF86AudioMute exec amixer -q set Master toggle
# pause / play
#bindsym XF86AudioPlay exec playerctl play-pause
bindcode 127 exec playerctl play-pause


# reload the configuration file
bindsym $modeTwo+Shift+C reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $modeOne+Shift+R restart
# exit i3 (logs you out of your X session)
bindsym $modeOne+Shift+E exit

# lockscreen
bindsym $modeTwo+Shift+L exec lockScreen

#screenshot todo

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # They resize the border in the direction you pressed, e.g.
        # when pressing left, the window is resized so that it has
        # more space on its left

		bindsym j resize shrink left 10 px or 10 ppt
		bindsym Shift+J resize grow   left 10 px or 10 ppt

		bindsym k resize shrink down 10 px or 10 ppt
		bindsym Shift+K resize grow   down 10 px or 10 ppt

		bindsym l resize shrink up 10 px or 10 ppt
		bindsym Shift+L resize grow   up 10 px or 10 ppt

		bindsym odiaeresis resize shrink right 10 px or 10 ppt
		bindsym Shift+Odiaeresis resize grow   right 10 px or 10 ppt

		# same bindings, but for the arrow keys
		bindsym Left resize shrink left 10 px or 10 ppt
		bindsym Shift+Left resize grow   left 10 px or 10 ppt

		bindsym Down resize shrink down 10 px or 10 ppt
		bindsym Shift+Down resize grow   down 10 px or 10 ppt

		bindsym Up resize shrink up 10 px or 10 ppt
		bindsym Shift+Up resize grow   up 10 px or 10 ppt

		bindsym Right resize shrink right 10 px or 10 ppt		bindsym Shift+Right resize grow   right 10 px or 10 ppt

		# back to normal: Enter or Escape
		bindsym Return mode "default"
		bindsym Escape mode "default"
}

bindsym $modeOne+$modeTwo+r mode "resize"

mode "gameMode" {
    bindsym $modeOne+Escape mode "default", exec xautolock -time 15 -locker lockScreen &
    # Multimedia Keys
    # increase volume
    bindsym XF86AudioRaiseVolume exec amixer -q set Master 5%+ unmute
    # decrease volume
    bindsym XF86AudioLowerVolume exec amixer -q set Master 5%- unmute
    # mute volume
    bindsym XF86AudioMute exec amixer -q set Master toggle
    # pause / play / next / previous
    #bindsym XF86AudioPlay exec playerctl play-pause
    bindcode 127 exec playerctl play-pause
}
bindsym $modeOne+Escape mode "gameMode", exec --no-startup-id killScreenSaver

# mouse speed
#exec xinput --set-prop 12 297 -0.8
exec python ~/scripts/mouseFix.py

#background color
exec hsetroot -solid #000000

mode "startPrograms" {
    bindsym t exec Telegram; mode "default"
    bindsym e exec thunderbird; mode "default"
    bindsym g exec firefox -private-window; mode "default"
    bindsym y exec spotify; mode "default"
    bindsym h exec startProgram; mode "default"
    bindsym s exec steam; mode "default"
    bindsym k exec kolourpaint; mode "default"
    bindsym l exec libreoffice; mode "default"
    bindsym i exec inkscape; mode "default"
    bindsym n exec nautilus; mode "default"
    bindsym f exec google-chrome-stable --incognito; mode "default"
    bindsym r exec gksudo system-config-printer; mode "default"
    bindsym u exec xmodmap ~/dev/config/xmodmap/xmodmap; mode "default"
    bindsym q exec ~/dev/config/screenlayout/daisy.sh; mode "default"
    bindsym a exec ~/dev/config/screenlayout/config.sh; mode "default"
    bindsym x exec slack; mode "default"
    bindsym w exec weather; mode "default"
    bindsym p exec flameshot gui; mode "default"
    bindsym $modeOne+g mode "default"
}
bindsym $modeOne+g mode "startPrograms" 
